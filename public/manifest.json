{
  "manifest_version": 3,
  "name": "Secret Arcade",
  "version": "1.0.0",
  "description": "Your tiny escape. A hidden mini arcade inside Chrome for quick 5–20 minute breaks.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Secret Arcade",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "commands": {
    "escape-mode": {
      "suggested_key": {
        "default": "Ctrl+Shift+X",
        "mac": "Command+Shift+X"
      },
      "description": "Instantly hide game and activate Escape Mode"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
