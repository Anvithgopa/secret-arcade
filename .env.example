# Cashfree Payment Gateway Configuration
# Official Docs: https://www.cashfree.com/docs

# 1. Your Cashfree Payment Form or Payment Link URL (Dashboard -> Payment Links / Forms):
VITE_CASHFREE_PAYMENT_LINK=https://payments.cashfree.com/forms/secret-arcade

# 2. Your Cashfree App ID / Client ID (Public - safe in extension):
VITE_CASHFREE_APP_ID=TEST_your_app_id_here

# 3. Cashfree Environment: SANDBOX (testing) or PRODUCTION (live):
VITE_CASHFREE_ENV=SANDBOX

# 4. Cashfree Secret Key (BACKEND ONLY - NEVER prefix with VITE_):
CASHFREE_SECRET_KEY=your_secret_key_here

# 5. Optional: Backend verification endpoint URL (Cloudflare Worker from server/verify-worker.js)
# Leave empty for pure client-safe receipt verification without backend
VITE_VERIFY_ENDPOINT=

